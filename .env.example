# Copy this file to a new file named .env and fill in your real values.
# NEVER share the .env file or upload it anywhere.

# Slack "Bot User OAuth Token" (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-paste-here

# Slack "App-Level Token" (starts with xapp-)
SLACK_APP_TOKEN=xapp-paste-here

# Your own Slack member ID (starts with U)
MY_SLACK_USER_ID=U-paste-here

# Claude API key (starts with sk-ant-) - not needed until step 3
ANTHROPIC_API_KEY=
